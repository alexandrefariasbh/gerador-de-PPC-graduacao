{
  "rules": {
    "projetos": {
      "$pid": {
        ".read": "auth != null && auth.token.email_verified == true && data.child('membros').child(auth.token.email.toLowerCase().replace('.', ',')).exists()",
        ".write": "auth != null && auth.token.email_verified == true && (data.child('membros').child(auth.token.email.toLowerCase().replace('.', ',')).exists() || (!data.exists() && newData.child('meta/dono').val() == auth.uid))",
        "meta": {
          "dono": { ".validate": "!data.exists() || newData.val() == data.val()" }
        }
      }
    },
    "indice": {
      "$k": {
        ".read": "auth != null && auth.token.email.toLowerCase().replace('.', ',') == $k",
        "$pid": {
          ".write": "auth != null && root.child('projetos').child($pid).child('membros').child(auth.token.email.toLowerCase().replace('.', ',')).exists()"
        }
      }
    },
    "presenca": {
      "$pid": {
        ".read": "auth != null && root.child('projetos').child($pid).child('membros').child(auth.token.email.toLowerCase().replace('.', ',')).exists()",
        "$uid": {
          ".write": "auth != null && auth.uid == $uid && root.child('projetos').child($pid).child('membros').child(auth.token.email.toLowerCase().replace('.', ',')).exists()"
        }
      }
    }
  }
}
